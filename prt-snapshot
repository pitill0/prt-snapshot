# Run privileged operations with a predictable executable search path.
# Do not set a process-wide restrictive umask here: prt-get/pkgutils inherit it
# and may recreate shared package metadata such as /var/lib/pkg/db.
PATH="/usr/sbin:/usr/bin:/sbin:/bin"
export PATH

msgError() {
  echo "$APPNAME: Error, $*" >&2
  exit 1
}

msgVersion() {
  echo "$APPNAME v$VERSION by Victor Martinez and Jose V Beneyto"
  exit 0
}

msgUsage() {
  local status="${1:-0}"

  echo "Usage: $APPNAME <command> [options]"
  echo "Where commands are:"
  echo "  clean         Remove all stored snapshots"
  echo "  store    msg  Take an snapshot of installed ports"
  echo "  restore  num [--dry-run|--yes]"
  echo "                 Restore to a status defined by certain snapshot"
  echo "  diff     num  Return differences between current status and a snapshot"
  echo "  show     num [--packages|--json]"
  echo "                 Show snapshot details, package names only, or JSON"
  echo "  list     [--json]"
  echo "                 List all stored snapshots or emit JSON"
  echo "  help          Show this help information"
  echo "  version       Show version information"
  exit "$status"
}

checkUID() {
  [ "$(id -u)" -ne 0 ] && msgError "you must be root to use $APPNAME"
}

checkVarDir() {
  local owner
  local mode

  [ -L "$VARDIR" ] && msgError "snapshot directory must not be a symbolic link"
  [ -d "$VARDIR" ] || msgError "can't access to directory $VARDIR"

  owner="$(stat -c '%u' "$VARDIR")" ||
    msgError "could not determine snapshot directory owner"
  [ "$owner" -eq 0 ] ||
    msgError "snapshot directory must be owned by root"

  mode="$(stat -c '%a' "$VARDIR")" ||
    msgError "could not determine snapshot directory permissions"

  if (( (8#$mode & 0022) != 0 )); then
    msgError "snapshot directory must not be writable by group or others"
  fi
}

releaseLock() {
  [ "${LOCK_HELD:-0}" -eq 1 ] || return 0

  rm -f -- "$LOCKDIR/pid"
  rmdir -- "$LOCKDIR" 2>/dev/null || true
  LOCK_HELD=0
}

acquireLock() {
  local lock_pid=""

  if mkdir -- "$LOCKDIR" 2>/dev/null; then
    if ! printf '%s\n' "$$" > "$LOCKDIR/pid"; then
      rmdir -- "$LOCKDIR" 2>/dev/null || true
      msgError "could not initialize snapshot lock"
    fi
    LOCK_HELD=1
    return 0
  fi

  # A lock left behind by an uncatchable termination may be recovered only
  # when it contains a valid PID that is no longer running.
  if [ -f "$LOCKDIR/pid" ]; then
    read -r lock_pid < "$LOCKDIR/pid" || lock_pid=""

    if [[ "$lock_pid" =~ ^[0-9]+$ ]] && kill -0 "$lock_pid" 2>/dev/null; then
      msgError "another $APPNAME operation is already running (pid $lock_pid)"
    fi

    if [[ "$lock_pid" =~ ^[0-9]+$ ]]; then
      rm -f -- "$LOCKDIR/pid"
      if ! rmdir -- "$LOCKDIR" 2>/dev/null; then
        msgError "could not remove stale snapshot lock"
      fi

      if mkdir -- "$LOCKDIR" 2>/dev/null; then
        if ! printf '%s\n' "$$" > "$LOCKDIR/pid"; then
          rmdir -- "$LOCKDIR" 2>/dev/null || true
          msgError "could not initialize snapshot lock"
        fi
        LOCK_HELD=1
        return 0
      fi
    fi
  fi

  msgError "snapshot store is locked or contains an invalid stale lock"
}

validateSnapshotId() {
  local snap="$1"

  [[ "$snap" =~ ^[0-9]+$ ]] || msgError "invalid snapshot id: $snap"
}

checkSnapFile() {
  local snap_file="$1"

  [ -f "$snap_file" ] || msgError "could not read snapshot file $snap_file"
}

validatePortName() {
  local port="$1"

  [[ "$port" =~ ^[A-Za-z0-9][A-Za-z0-9+_.-]*$ ]] ||
    msgError "invalid port name in snapshot data: $port"
}

cleanupTempFiles() {
  [ -n "${TEMP_FILE:-}" ] && rm -f -- "$TEMP_FILE"
  [ -n "${RESTORE_FILE:-}" ] && rm -f -- "$RESTORE_FILE"
  [ -n "${INSTALL_FILE:-}" ] && rm -f -- "$INSTALL_FILE"
  releaseLock
}

captureCurrentState() {
  local output="$1"

  if ! prt-get listinst > "$output"; then
    rm -f -- "$output"
    msgError "could not query installed ports"
  fi
}

makeSnapshot() {
  # Create the snapshot in a temporary file and publish it only after
  # prt-get has completed successfully.
  local num="$1"
  shift
  local msg="$*"
  local snap_file="$VARDIR/$num.snap"
  local msg_file="$VARDIR/$num.msg"
  local snap_tmp
  local msg_tmp

  [ ! -e "$snap_file" ] || msgError "snapshot $num already exists"
  [ ! -e "$msg_file" ] || msgError "snapshot message $num already exists"

  snap_tmp="$(mktemp "$VARDIR/.snapshot.XXXXXX")" ||
    msgError "could not create temporary snapshot file"
  msg_tmp="$(mktemp "$VARDIR/.message.XXXXXX")" || {
    rm -f -- "$snap_tmp"
    msgError "could not create temporary message file"
  }

  if ! printf '%s\n' "$msg" > "$msg_tmp"; then
    rm -f -- "$snap_tmp" "$msg_tmp"
    msgError "could not write snapshot message"
  fi

  if ! prt-get listinst > "$snap_tmp"; then
    rm -f -- "$snap_tmp" "$msg_tmp"
    msgError "could not query installed ports"
  fi

  if ! chmod 0600 -- "$snap_tmp" "$msg_tmp"; then
    rm -f -- "$snap_tmp" "$msg_tmp"
    msgError "could not secure snapshot files"
  fi

  # Publish the .snap file last: list/getSnapshotIndex only consider .snap files,
  # so a snapshot becomes visible only after all its data is ready.
  if ! mv -- "$msg_tmp" "$msg_file"; then
    rm -f -- "$snap_tmp" "$msg_tmp"
    msgError "could not store snapshot message"
  fi

  if ! mv -- "$snap_tmp" "$snap_file"; then
    rm -f -- "$snap_tmp" "$msg_file"
    msgError "could not store snapshot"
  fi
}

diffSnapshot() {
  # Compare current package state with a stored snapshot without creating
  # a numbered snapshot in the persistent history.
  local snap="$1"
  local snap_end
  local diff_status

  validateSnapshotId "$snap"
  snap_end="$VARDIR/$snap.snap"
  checkSnapFile "$snap_end"

  TEMP_FILE="$(mktemp "$VARDIR/.current.XXXXXX")" ||
    msgError "could not create temporary snapshot file"

  captureCurrentState "$TEMP_FILE"

  diff "$TEMP_FILE" "$snap_end" | grep -e '^>' -e '^<'
  diff_status="${PIPESTATUS[0]}"

  rm -f -- "$TEMP_FILE"
  TEMP_FILE=""

  # diff returns 0 for identical files and 1 for differences.
  [ "$diff_status" -le 1 ] || msgError "could not compare snapshot $snap"
}

getSnapshotIndex() {
  # Return max(existing numeric snapshot ids) + 1. Counting files is unsafe
  # when there are gaps in the snapshot history.
  local snap_file
  local snap_id
  local max=0

  while IFS= read -r snap_file; do
    snap_id="$(basename "$snap_file" .snap)"
    [[ "$snap_id" =~ ^[0-9]+$ ]] || continue
    (( snap_id > max )) && max="$snap_id"
  done < <(find "$VARDIR" -maxdepth 1 -type f -name '*.snap' -print)

  echo $((max + 1))
}

cleanSnapshot() {
  # Remove only files that match prt-snapshot's numeric snapshot namespace.
  local snap_file
  local snap_id

  while IFS= read -r snap_file; do
    snap_id="$(basename "$snap_file" .snap)"
    [[ "$snap_id" =~ ^[0-9]+$ ]] || continue
    rm -f -- "$VARDIR/$snap_id.snap" "$VARDIR/$snap_id.msg"
  done < <(find "$VARDIR" -maxdepth 1 -type f -name '*.snap' -print)
}

storeSnapshot() {
  # Store a new snapshot with a message.
  local msg="$1"
  local num

  num="$(getSnapshotIndex)"
  makeSnapshot "$num" "$msg"
}

validateRestorePlan() {
  local symbol
  local port
  local extra

  # Validate the complete plan before executing the first destructive command.
  while read -r symbol port extra; do
    [ -n "$symbol" ] || continue

    [ -z "${extra:-}" ] ||
      msgError "invalid restore operation in snapshot diff"

    case "$symbol" in
      "<"|">")
        ;;
      *)
        msgError "invalid restore operation in snapshot diff"
        ;;
    esac

    [ -n "${port:-}" ] ||
      msgError "invalid restore operation in snapshot diff"
    validatePortName "$port"
  done < "$RESTORE_FILE"
}

buildInstallOrder() {
  local symbol
  local port
  local dep
  local deps
  declare -A missing=()
  declare -A added=()

  INSTALL_FILE="$(mktemp "$VARDIR/.install.XXXXXX")" ||
    msgError "could not create temporary install-order file"

  while read -r symbol port; do
    [ "$symbol" = ">" ] || continue
    missing["$port"]=1
  done < "$RESTORE_FILE"

  while read -r symbol port; do
    [ "$symbol" = ">" ] || continue

    if ! deps="$(prt-get quickdep "$port")"; then
      msgError "could not resolve dependency order for port: $port"
    fi

    for dep in $deps; do
      validatePortName "$dep"

      # quickdep may expose dependencies introduced by the current ports tree.
      # Use those results only to order packages already present in the target
      # snapshot; never expand restore membership.
      if [ "${missing[$dep]:-0}" -eq 1 ] &&
         [ "${added[$dep]:-0}" -eq 0 ]; then
        printf '%s\n' "$dep" >> "$INSTALL_FILE"
        added["$dep"]=1
      fi
    done

    # Be defensive if a quickdep implementation omits the requested port.
    if [ "${added[$port]:-0}" -eq 0 ]; then
      printf '%s\n' "$port" >> "$INSTALL_FILE"
      added["$port"]=1
    fi
  done < "$RESTORE_FILE"
}

printRestorePlan() {
  local snap="$1"
  local symbol
  local port
  local remove_count=0
  local install_count=0

  while read -r symbol port; do
    case "$symbol" in
      "<") remove_count=$((remove_count + 1)) ;;
      ">") install_count=$((install_count + 1)) ;;
    esac
  done < "$RESTORE_FILE"

  printf 'Restore plan for snapshot %s:\n' "$snap"
  printf '  Remove (%d):\n' "$remove_count"
  while read -r symbol port; do
    [ "$symbol" = "<" ] && printf '    %s\n' "$port"
  done < "$RESTORE_FILE"

  printf '  Install (%d):\n' "$install_count"
  while IFS= read -r port; do
    printf '    %s\n' "$port"
  done < "$INSTALL_FILE"
}

confirmRestore() {
  local answer

  if [ ! -t 0 ]; then
    msgError "restore requires confirmation; use --yes or --dry-run in non-interactive mode"
  fi

  printf 'Proceed with restore? [y/N] '
  read -r answer || return 1

  case "$answer" in
    y|Y|yes|YES|Yes)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

applyRestorePlan() {
  local symbol
  local port

  # Removal membership comes directly from the validated restore diff.
  while read -r symbol port; do
    [ "$symbol" = "<" ] || continue

    if ! (umask 022; prt-get remove "$port"); then
      msgError "failed to remove port: $port"
    fi
  done < "$RESTORE_FILE"

  # Install only target-snapshot members, in quickdep-derived order.
  while IFS= read -r port; do
    if ! (umask 022; prt-get install "$port"); then
      msgError "failed to install port: $port"
    fi
  done < "$INSTALL_FILE"
}

pruneSnapshotHistory() {
  local snap="$1"
  local snap_file
  local snap_id

  while IFS= read -r snap_file; do
    snap_id="$(basename "$snap_file" .snap)"
    [[ "$snap_id" =~ ^[0-9]+$ ]] || continue

    if (( snap_id > snap )); then
      rm -f -- "$VARDIR/$snap_id.snap" "$VARDIR/$snap_id.msg"
    fi
  done < <(find "$VARDIR" -maxdepth 1 -type f -name '*.snap' -print)
}

restoreSnapshot() {
  # Restore package membership to a previous snapshot. The complete plan is
  # validated and shown before any package operation is allowed to run.
  local snap="$1"
  local mode="${2:-prompt}"

  validateSnapshotId "$snap"
  checkSnapFile "$VARDIR/$snap.snap"

  RESTORE_FILE="$(mktemp "$VARDIR/.restore.XXXXXX")" ||
    msgError "could not create temporary restore file"

  if ! diffSnapshot "$snap" > "$RESTORE_FILE"; then
    msgError "could not calculate restore operations"
  fi

  validateRestorePlan
  buildInstallOrder
  printRestorePlan "$snap"

  if [ "$mode" = "dry-run" ]; then
    rm -f -- "$RESTORE_FILE" "$INSTALL_FILE"
    RESTORE_FILE=""
    INSTALL_FILE=""
    return 0
  fi

  if [ "$mode" = "prompt" ] && ! confirmRestore; then
    rm -f -- "$RESTORE_FILE" "$INSTALL_FILE"
    RESTORE_FILE=""
    INSTALL_FILE=""
    printf 'Restore cancelled.\n'
    return 0
  fi

  applyRestorePlan

  rm -f -- "$RESTORE_FILE" "$INSTALL_FILE"
  RESTORE_FILE=""
  INSTALL_FILE=""

  # Only a successful, applied restore may prune newer snapshot history.
  pruneSnapshotHistory "$snap"
}

jsonEscape() {
  local value="$1"
  local char
  local code
  local i
  local LC_ALL=C

  for ((i = 0; i < ${#value}; i++)); do
    char="${value:i:1}"

    case "$char" in
      '"')
        printf '%s' "\\\""
        ;;
      "\\")
        printf '%s' "\\\\"
        ;;
      *)
        printf -v code '%d' "'$char"
        if [ "$code" -lt 32 ]; then
          printf '\\u%04x' "$code"
        else
          printf '%s' "$char"
        fi
        ;;
    esac
  done
}

printShowJson() {
  local snap="$1"
  local timestamp="$2"
  local message="$3"
  local snap_file="$4"
  local port
  local first=1

  printf '{\n'
  printf '  "schema": 1,\n'
  printf '  "id": %s,\n' "$snap"

  printf '  "created": "'
  jsonEscape "$timestamp"
  printf '",\n'

  printf '  "message": "'
  jsonEscape "$message"
  printf '",\n'

  printf '  "packages": ['

  while IFS= read -r port || [ -n "$port" ]; do
    if [ "$first" -eq 1 ]; then
      printf '\n'
      first=0
    else
      printf ',\n'
    fi

    printf '    "'
    jsonEscape "$port"
    printf '"'
  done < "$snap_file"

  if [ "$first" -eq 1 ]; then
    printf ']\n'
  else
    printf '\n  ]\n'
  fi

  printf '}\n'
}

showSnapshot() {
  local snap="$1"
  local mode="${2:-full}"
  local snap_file
  local msg_file
  local timestamp
  local message=""
  local port
  local count=0

  validateSnapshotId "$snap"

  snap_file="$VARDIR/$snap.snap"
  msg_file="$VARDIR/$snap.msg"
  checkSnapFile "$snap_file"

  # Validate the complete snapshot before producing output.
  while IFS= read -r port || [ -n "$port" ]; do
    [ -n "$port" ] || msgError "invalid empty port name in snapshot data"
    validatePortName "$port"
    count=$((count + 1))
  done < "$snap_file"

  if [ "$mode" = "packages" ]; then
    cat -- "$snap_file"
    return 0
  fi

  timestamp="$(stat -c '%y' "$snap_file" | cut -d'.' -f1)" ||
    msgError "could not determine snapshot timestamp"

  if [ "$mode" = "json" ]; then
    if [ -f "$msg_file" ]; then
      message="$(cat -- "$msg_file")"
    fi

    printShowJson "$snap" "$timestamp" "$message" "$snap_file"
    return 0
  fi

  if [ -f "$msg_file" ]; then
    message="$(tr '\n' ' ' < "$msg_file")"
  fi

  printf 'Snapshot: %s\n' "$snap"
  printf 'Created: %s\n' "$timestamp"
  printf 'Message: %s\n' "$message"
  printf 'Packages (%d):\n' "$count"

  while IFS= read -r port || [ -n "$port" ]; do
    printf '  %s\n' "$port"
  done < "$snap_file"
}

listSnapshotJson() {
  local snap_file
  local snap_id
  local timestamp
  local msg_file
  local message
  local first=1
  local i
  local -a ids=()
  local -a timestamps=()
  local -a messages=()

  while IFS= read -r snap_id; do
    snap_file="$VARDIR/$snap_id.snap"
    msg_file="$VARDIR/$snap_id.msg"

    timestamp="$(stat -c '%y' "$snap_file")" ||
      msgError "could not determine snapshot timestamp"
    timestamp="${timestamp%%.*}"

    message=""
    if [ -f "$msg_file" ]; then
      if ! message="$(cat -- "$msg_file")"; then
        msgError "could not read snapshot message $msg_file"
      fi
    fi

    ids+=("$snap_id")
    timestamps+=("$timestamp")
    messages+=("$message")
  done < <(
    while IFS= read -r snap_file; do
      snap_id="$(basename "$snap_file" .snap)"
      [[ "$snap_id" =~ ^[0-9]+$ ]] || continue
      printf '%s\n' "$snap_id"
    done < <(find "$VARDIR" -maxdepth 1 -type f -name '*.snap' -print) |
    sort -n
  )

  printf '{\n'
  printf '  "schema": 1,\n'
  printf '  "snapshots": ['

  for ((i = 0; i < ${#ids[@]}; i++)); do
    if [ "$first" -eq 1 ]; then
      printf '\n'
      first=0
    else
      printf ',\n'
    fi

    printf '    {\n'
    printf '      "id": %s,\n' "${ids[$i]}"

    printf '      "created": "'
    jsonEscape "${timestamps[$i]}"
    printf '",\n'

    printf '      "message": "'
    jsonEscape "${messages[$i]}"
    printf '"\n'

    printf '    }'
  done

  if [ "$first" -eq 1 ]; then
    printf ']\n'
  else
    printf '\n  ]\n'
  fi

  printf '}\n'
}

listSnapshot() {
  # Return a list of all stored snapshots in numeric order.
  local snap_file
  local snap_id
  local timestamp
  local msg_file

  while IFS= read -r snap_file; do
    snap_id="$(basename "$snap_file" .snap)"
    [[ "$snap_id" =~ ^[0-9]+$ ]] || continue
    printf '%s\n' "$snap_id"
  done < <(find "$VARDIR" -maxdepth 1 -type f -name '*.snap' -print) |
  sort -n |
  while IFS= read -r snap_id; do
    snap_file="$VARDIR/$snap_id.snap"
    msg_file="$VARDIR/$snap_id.msg"
    timestamp="$(stat -c '%y' "$snap_file" | cut -d'.' -f1)"

    if [ -f "$msg_file" ]; then
      printf '%s -- %s -- %s\n' \
        "$snap_id" "$timestamp" "$(tr '\n' ' ' < "$msg_file")"
    else
      printf '%s -- %s --\n' "$snap_id" "$timestamp"
    fi
  done
}

main() {
  case "$1" in
    clean)
      checkUID
      checkVarDir
      acquireLock
      cleanSnapshot
      releaseLock
      ;;
    store)
      [ "$#" -ne 2 ] && msgUsage 1
      checkUID
      checkVarDir
      acquireLock
      shift
      storeSnapshot "$@"
      releaseLock
      ;;
    restore)
      [ "$#" -lt 2 ] && msgUsage 1
      [ "$#" -gt 3 ] && msgUsage 1

      case "${3:-}" in
        "")
          restore_mode="prompt"
          ;;
        --dry-run)
          restore_mode="dry-run"
          ;;
        --yes)
          restore_mode="yes"
          ;;
        *)
          msgUsage 1
          ;;
      esac

      checkUID
      checkVarDir
      acquireLock
      restoreSnapshot "$2" "$restore_mode"
      releaseLock
      ;;
    diff)
      [ "$#" -ne 2 ] && msgUsage 1
      checkUID
      checkVarDir
      acquireLock
      diffSnapshot "$2"
      releaseLock
      ;;
    show)
      [ "$#" -lt 2 ] && msgUsage 1
      [ "$#" -gt 3 ] && msgUsage 1

      case "${3:-}" in
        "")
          show_mode="full"
          ;;
        --packages)
          show_mode="packages"
          ;;
        --json)
          show_mode="json"
          ;;
        *)
          msgUsage 1
          ;;
      esac

      checkUID
      checkVarDir
      acquireLock
      showSnapshot "$2" "$show_mode"
      releaseLock
      ;;
    list)
      [ "$#" -gt 2 ] && msgUsage 1

      case "${2:-}" in
        "")
          list_mode="human"
          ;;
        --json)
          list_mode="json"
          ;;
        *)
          msgUsage 1
          ;;
      esac

      checkUID
      checkVarDir
      acquireLock
      if [ "$list_mode" = "json" ]; then
        listSnapshotJson
      else
        listSnapshot
      fi
      releaseLock
      ;;
    help)
      msgUsage
      ;;
    version)
      msgVersion
      ;;
    *)
      msgUsage 1
      ;;
  esac
}

VERSION=0.5.1
APPNAME="$(basename "$0")"

VARDIR="/var/lib/pkg/snapshots"
LOCKDIR="$VARDIR/.lock"
LOCK_HELD=0
TEMP_FILE=""
RESTORE_FILE=""
INSTALL_FILE=""

trap cleanupTempFiles EXIT INT TERM

[ "$#" -lt 1 ] && msgUsage 1

main "$@"

# End of file
